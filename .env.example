# ===================================================================
# Cloudflare R2 - Credenciales y Configuración de Almacenamiento S3
# IMPORTANTE: Estas credenciales se ejecutan EXCLUSIVAMENTE en el servidor.
# NO las expongas en variables VITE_* ni las envíes al navegador.
# ===================================================================

# Cloudflare Account ID o Endpoint S3 completo
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<tu-account-id>.r2.cloudflarestorage.com

# Access Key ID y Secret Access Key (S3 API Credentials de Cloudflare R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre del bucket en Cloudflare R2
R2_BUCKET_NAME=antigravity-storage

# Región (en Cloudflare R2 es "auto")
R2_REGION=auto

# Dominio público personalizado o r2.dev (opcional, para URLs directas de lectura)
# Si se deja vacío, la aplicación generará automáticamente URLs firmadas privadas con expiración.
R2_PUBLIC_URL=

# ===================================================================
# ElevenLabs API Key para Transcripción de Notas de Voz (Scribe STT)
# ===================================================================
ELEVENLABS_API_KEY=
